# =====================================================================
# TwinPath AI — environment template. Copy to `.env` and replace EVERY
# placeholder. Never commit `.env`. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================

# --- runtime environment: development | test | staging | production ---
TWINPATH_ENV=development

# --- PostgreSQL bootstrap (docker compose `db` service only) ---
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
TWINPATH_OWNER_PASSWORD=change-me-owner
TWINPATH_APP_PASSWORD=change-me-app
TWINPATH_DATABASES="twinpath twinpath_test"

# --- Backend database URLs ---
# Runtime connections use the least-privilege app role.
DATABASE_URL=postgresql+psycopg://twinpath_app:change-me-app@127.0.0.1:5433/twinpath
# Migrations use the schema-owner role.
MIGRATION_DATABASE_URL=postgresql+psycopg://twinpath_owner:change-me-owner@127.0.0.1:5433/twinpath
# Tests (separate database; never point this at real data).
TEST_DATABASE_URL=postgresql+psycopg://twinpath_app:change-me-app@127.0.0.1:5433/twinpath_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://twinpath_owner:change-me-owner@127.0.0.1:5433/twinpath_test
# production: append ?sslmode=verify-full&sslrootcert=/path/to/ca.pem
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Security ---
# Used for HMAC of rate-limit keys and audit pseudonymisation. 48+ random bytes.
SECRET_KEY=replace-with-48-random-bytes
# Fernet key protecting MFA secrets at rest:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# Cookies are always HttpOnly + SameSite=Lax. `Secure` must be true outside local dev.
COOKIE_SECURE=true
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=12

# --- Email (verification + password reset) ---
# file  : writes .eml files to backend/var/outbox (development only)
# smtp  : real delivery (required in staging/production)
# none  : disabled -> email verification cannot be required
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TwinPath AI <no-reply@example.invalid>
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_APP_URL=http://localhost:5173

# --- Local LLM (Ollama). Must NOT be reachable from the public internet. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=180
MENTOR_MAX_CONCURRENT=1
MENTOR_MAX_QUEUE=4

# --- Storage (outside any public static directory) ---
DATA_DIR=./var
MAX_UPLOAD_MB=5
DOCUMENT_RETENTION_DAYS=180
CHAT_RETENTION_DAYS=180

# --- ML ---
MODEL_ARTIFACT_DIR=./artifacts/models
