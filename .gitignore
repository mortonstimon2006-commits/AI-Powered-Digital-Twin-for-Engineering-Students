# --- secrets & local config ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
